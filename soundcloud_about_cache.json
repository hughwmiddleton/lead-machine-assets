_track_genre": "", "latest_track_tags": []}}, "kevinferhati": {"ts": 1763094490.90337, "etag": "", "last_modified": "", "data": {"handle": "kevinferhati", "display_name": "Kevin Ferhati", "external_urls": ["https://www.instagram.com/kevinf3rhati/", "kevinf3rhati@gmail.com", "https://www.residentadvisor.net/dj/kevinferhati", "http://firefox.com", "http://kevinferhati.bandcamp.com/", "https://www.beatport.com/artist/kevin-ferhati/803587"], "emails": [], "city": "Germany", "country": "", "genre": "", "elapsed_ms": 1781, "aggregator_expanded": 0, "bio_text": "Kevin Ferhati is an American DJ/Producer who began his journey in 2016, releasing his debut record in 2018. Since then, he has been known for crafting immersive, intricate soundscapes that blend deep techno with ethereal atmospheres.\n\nFerhati is recognized for his fearless approach to Music making, constantly pushing the boundaries of experimentation. His sonic explorations span a diverse spectrum, from the darkest depths of techno to the ethereal heights of ancient soundscapes. With each release, Ferhati invites listeners on a transformative journey, where the familiar meets the unknown in a sonic experimentation.\n\nThroughout his career, Ferhati has remained true to his artistic vision, always seeking to push the boundaries of what is possible in techno. With a relentless dedication to his craft and a fearless spirit of exploration, Kevin Ferhati continues to redefine the landscape of contemporary electronic music.\n\nAs the founder of \u00c4rtifakt a US Series now Label Since 2024 , Ferhati Aims to be Releasing to his own imprint and collaborating with artists who share his artistic vision. \u00c4rtifakt is a platform that emphasizes emotional depth, texture, and space exploration and expression.", "sounds_like": "", "latest_track_title": "", "latest_track_release_date": "", "latest_track_precision": "", "latest_track_genre": "", "latest_track_tags": []}}, "brudi-spargel": {"ts": 1763094491.426361, "etag": ""