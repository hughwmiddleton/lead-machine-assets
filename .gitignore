.vscode/settings.json

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# Environment / secrets
.env
.env.*
!.env.example

# Runtime logs
*.log

# Browser / session state
night_fb_profile/
chrome_profile/
browser_profile/
/.../

# Bounded local diagnostics
/runtime/debug/
/fb_attach_*.png
/fb_home.png
/fb_known_page.png
/fb_search.png

# SoundCloud cache
soundcloud_about_cache.json

# FB DOM gate debug dumps
fb_dom_gate_debug_*.json

# Editor and process temporary files
*.tmp
*.swp
*~

# Timestamped run directories are generated operational history. Keep them on
# disk (or archive them outside the repository), but do not accumulate new runs
# in source control. Curated regression evidence belongs in tests/fixtures.
!/overnight_runs/
/overnight_runs/20??-??-??_*/
/overnight_runs/ticket5d-v1-acceptance/
/overnight_runs/undiscovered_music_handoff_smoke_runs/
/overnight_runs/undiscovered_music_handoff_smoke_*.json

# Persistent recovery state must remain visible to operators and Git status.
!/overnight_runs/unearthed_cursor.json

# Temporary validation artifacts
validation_run.log
validation_run_config.json
