.vscode/settings.json

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# Environment / secrets
.env
.env.*
!.env.example

# Runtime logs
*.log

# Browser / session state
night_fb_profile/
chrome_profile/
browser_profile/
/.../

# Bounded local diagnostics
/runtime/debug/
/fb_attach_*.png
/fb_home.png
/fb_known_page.png
/fb_search.png

# SoundCloud cache
soundcloud_about_cache.json

# FB DOM gate debug dumps
fb_dom_gate_debug_*.json

# Editor and process temporary files
*.tmp
*.swp
*~

# Operational run/recovery state is intentionally not ignored. In particular,
# keep overnight runs, runtime progress, master backups, and Lead Vault contacts
# visible to operators and Git status so they cannot be discarded as cache.
!/overnight_runs/
!/overnight_runs/**

# Temporary validation artifacts
validation_run.log
validation_run_config.json
